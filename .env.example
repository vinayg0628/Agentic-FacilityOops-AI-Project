# ─────────────────────────────────────────────────────────────────────────────
#  AGENTIC FACILITYOPS AI PLATFORM — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME="Agentic FacilityOps AI Platform"
ENVIRONMENT=development          # development | staging | production
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
DEBUG=true

# ── Backend Server ────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default – development only)
DATABASE_URL=sqlite:///./facilityops.db

# PostgreSQL (recommended for staging / production)
# DATABASE_URL=postgresql://facilityops_user:your_password@localhost:5432/facilityops_db

# PostgreSQL connection details (used by Docker Compose)
POSTGRES_DB=facilityops_db
POSTGRES_USER=facilityops_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (caching & real-time pub/sub) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:3000"]

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_APP_NAME="FacilityOps AI"
VITE_ENV=development

# ── Email (Alerts & Reports) ──────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── AI / ML ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
ML_MODEL_PATH=./ml_models

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50

# ── Replay / Live Demo ────────────────────────────────────────────────────────
# Enable the live-replay engine to stream CSV rows into the DB row-by-row,
# simulating a real IoT sensor feed during demos or development.
#
# REPLAY_MODE              set true to activate the replay daemon thread
# REPLAY_INTERVAL_SECONDS  how often a new row is inserted (seconds)
# REPLAY_DURATION_MINUTES  stop automatically after N minutes;
#                          comment out (or leave blank) for indefinite looping
#
# Demo math: 15 s × 120 inserts = 30 min → ~120 visible dashboard updates
#
REPLAY_MODE=false
REPLAY_INTERVAL_SECONDS=15
REPLAY_DURATION_MINUTES=30
